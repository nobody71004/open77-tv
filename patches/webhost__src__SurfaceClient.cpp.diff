+/// A pipe-backed CEF reader: the WebM ffmpeg writes arrives as CEF reads it.
+///
+/// The owning handles live in the reader, so the lifetime is exactly the
+/// response: when CEF has read the last byte (or abandons the request), the
+/// object is released, the pipe closes, and the job handle's closure kills any
+/// still-running encoder. There is no ordering problem to reason about because
+/// there is nothing left to clean up on another thread.
+class PipeReader final : public CefReadHandler
+{
+public:
+    PipeReader(HANDLE aReadEnd, HANDLE aProcess, HANDLE aJob)
+        : m_readEnd(aReadEnd), m_process(aProcess), m_job(aJob)
+    {
+    }
+
+    ~PipeReader() override
+    {
+        if (m_readEnd != nullptr) CloseHandle(m_readEnd);
+        if (m_process != nullptr) CloseHandle(m_process);
+        if (m_job != nullptr) CloseHandle(m_job);
+    }
+
+    PipeReader(const PipeReader&) = delete;
+    PipeReader& operator=(const PipeReader&) = delete;
+
+    size_t Read(void* aPtr, const size_t aSize, const size_t aCount) override
+    {
+        if (m_readEnd == nullptr || aSize == 0 || aCount == 0) return 0;
+        // CEF asks for `aSize * aCount` bytes; a pipe read is capped at 0x7FFF,
+        // so clamp. A short read is not an error for this handler -- the next
+        // call continues the stream.
+        DWORD want = static_cast<DWORD>(aSize * aCount);
+        if (want > 0x7FFF) want = 0x7FFF;
+        DWORD got = 0;
+        if (!ReadFile(m_readEnd, aPtr, want, &got, nullptr)) return 0;
+        if (got == 0) return 0;
+        m_eof = false;
+        return static_cast<size_t>(got);
+    }
+
+    int Seek(int64_t, int) override { return -1; } // A live pipe does not seek.
+    int64_t Tell() override { return 0; }
+    int Eof() override { return m_eof ? 1 : 0; }
+    bool MayBlock() override { return true; }
+
+private:
+    HANDLE m_readEnd;
+    HANDLE m_process;
+    HANDLE m_job;
+    bool m_eof = true;
+
+    IMPLEMENT_REFCOUNTING(PipeReader);
+};
