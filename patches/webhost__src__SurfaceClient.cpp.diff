+CefRefPtr<CefResourceHandler> SurfaceClient::MaybeServeTranscodeRoute(CefRefPtr<CefRequest> aRequest)
+{
+    const std::string url = aRequest->GetURL().ToString();
+    if (!SameOrigin(url)) return nullptr;
+    const std::string path = Lower(RoutePath(url));
+    const bool isProbe = path == "/op77/media/probe";
+    const bool isStream = path == "/op77/media/stream";
+    if (!isProbe && !isStream) return nullptr;
+
+    const auto runtime = m_runtime.lock();
+    const auto& decoder = runtime ? runtime->DecoderPaths() : op77::WebUI::Transcode::DecoderPaths{};
+    const std::string disabledReason = op77::WebUI::Transcode::DisabledReason(decoder);
+    if (!disabledReason.empty() || m_definition.pagePolicy != WebPagePolicy::Media)
+    {
+        const std::string body = "{\"verdict\":\"disabled\",\"detail\":\"" +
+            JsonQuote(disabledReason.empty() ? "this surface's page policy does not permit it" : disabledReason) +
+            "\"}";
+        runtime->Trace("media_route:refused policy=" +
+            std::string(Describe(m_definition.pagePolicy)) + " path=" + path);
+        return TextAnswer(body, "application/json");
+    }
+
+    const auto query = op77::WebUI::Transcode::ParseRouteQuery(RouteQueryPart(url));
+    if (!query.error.empty())
+    {
+        return TextAnswer(op77::WebUI::Transcode::BuildProbeJson({}, op77::WebUI::Transcode::Verdict::Nothing,
+                                                                 query.error),
+                          "application/json");
+    }
+
+    if (isProbe)
+    {
+        const auto result = op77::WebUI::Transcode::RunProbe(decoder, query.source);
+        op77::WebUI::Transcode::Probe probe;
+        std::string detail;
+        auto verdict = op77::WebUI::Transcode::Verdict::Nothing;
+        if (result.timedOut)
+        {
+            detail = "the decoder did not answer in time";
+        }
+        else if (!result.started || result.exitCode != 0)
+        {
+            detail = result.output.empty() ? "the decoder refused the link"
+                                           : result.output.substr(0, 200);
+        }
+        else
+        {
+            probe = op77::WebUI::Transcode::ParseProbeCsv(result.output);
+            verdict = op77::WebUI::Transcode::Judge(probe);
+        }
+        runtime->Trace("media_probe: " + op77::WebUI::Transcode::Describe(probe) + " -> " +
+            op77::WebUI::Transcode::Describe(verdict));
+        return TextAnswer(op77::WebUI::Transcode::BuildProbeJson(probe, verdict, detail),
+                          "application/json");
+    }
+
+    // The stream route. The response has no length -- it is live -- and the
+    // reader owns the three handles whose closure stops the encoder.
+    const auto start = op77::WebUI::Transcode::StartStream(decoder, query.source, query.startSeconds);
+    if (!start.started)
+    {
+        runtime->Trace("media_stream:failed " + start.failure);
+        return TextAnswer(op77::WebUI::Transcode::BuildProbeJson({}, op77::WebUI::Transcode::Verdict::Nothing,
+                                                                 start.failure),
+                          "application/json");
+    }
+    runtime->Trace("media_stream:started ss=" + std::to_string(query.startSeconds) + " src=" + query.source);
+    auto reader = CefRefPtr<PipeReader>(new PipeReader(start.readEnd, start.process, start.job));
+    CefResponse::HeaderMap headers;
+    headers.emplace("Cache-Control", "no-store");
+    headers.emplace("Access-Control-Allow-Origin", "*");
+    return new CefStreamResourceHandler(200, "OK", "video/webm", std::move(headers),
+        CefStreamReader::CreateForHandler(reader));
+}
