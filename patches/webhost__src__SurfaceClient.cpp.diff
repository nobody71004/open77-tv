+// ---------------------------------------------------------------------------
+// The transcode routes
+// ---------------------------------------------------------------------------
+//
+// Two same-origin URLs a media page may name, served from inside this process:
+//
+//     /op77/media/probe?u=...       what the decoder says the link is
+//     /op77/media/stream?u=...&ss=  the link, decoded live into WebM
+//
+// There is no listener, port or token: the requests arrive through CEF's own
+// resource dispatch, gated by `SameOrigin`, which means only the page itself
+// can name them -- the same trust boundary every other page file already sits
+// behind. A strict-policy page never reaches the decoder: the routes answer
+// `transcode_disabled` before the policy check would even matter, because a
+// page that cannot reach YouTube's origins has no use for a re-encoded stream
+// either.
+
+/// The path part of a URL, unescaped, without its query.
+std::string RoutePath(const std::string& aUrl)
+{
+    CefURLParts parts;
+    if (!CefParseURL(aUrl, parts)) return {};
+    const auto rules = static_cast<cef_uri_unescape_rule_t>(
+        UU_SPACES | UU_URL_SPECIAL_CHARS_EXCEPT_PATH_SEPARATORS);
+    std::string path = CefURIDecode(CefString(&parts.path), true, rules).ToString();
+    const std::size_t query = path.find('?');
+    if (query != std::string::npos) path.resize(query);
+    return path;
+}
+
+std::string RouteQueryPart(const std::string& aUrl)
+{
+    CefURLParts parts;
+    if (!CefParseURL(aUrl, parts)) return {};
+    return CefString(&parts.query).ToString();
+}
+
+/// One `name=value` out of a URL's query, percent-decoded.
+///
+/// Decoded by hand rather than with `CefURIDecode` because the value is itself a
+/// whole URL: decoding a `%2F` here would turn the separator between somebody
+/// else's path segments into a `/`, which changes what is fetched. `+` is left
+/// alone, because `encodeURIComponent` -- which is what writes this query --
+/// spells a space `%20` and never `+`, so a `+` in this position is a `+`.
+std::string RouteQueryParameter(const std::string& aQuery, const std::string_view aName)
+{
+    const auto hex = [](const char aCharacter) -> int
+    {
+        if (aCharacter >= '0' && aCharacter <= '9') return aCharacter - '0';
+        if (aCharacter >= 'a' && aCharacter <= 'f') return aCharacter - 'a' + 10;
+        if (aCharacter >= 'A' && aCharacter <= 'F') return aCharacter - 'A' + 10;
+        return -1;
+    };
+    std::size_t at = 0;
+    for (;;)
+    {
+        const std::size_t end = aQuery.find('&', at);
+        const std::string_view pair(aQuery.data() + at,
+            (end == std::string::npos ? aQuery.size() : end) - at);
+        const std::size_t equals = pair.find('=');
+        if (equals != std::string_view::npos && pair.substr(0, equals) == aName)
+        {
+            std::string value;
+            const std::string_view encoded = pair.substr(equals + 1);
+            for (std::size_t i = 0; i < encoded.size(); ++i)
+            {
+                if (encoded[i] == '%' && i + 2 < encoded.size() && hex(encoded[i + 1]) >= 0 &&
+                    hex(encoded[i + 2]) >= 0)
+                {
+                    value.push_back(static_cast<char>((hex(encoded[i + 1]) << 4) | hex(encoded[i + 2])));
+                    i += 2;
+                }
+                else value.push_back(encoded[i]);
+            }
+            return value;
+        }
+        if (end == std::string::npos) break;
+        at = end + 1;
+    }
+    return {};
+}
