+bool SurfaceClient::EnsureAudio()
+{
+    if (m_audio != nullptr) return true;
+    if (m_audioFormat.channels == 0 || m_audioFormat.sampleRate == 0) return false;
+    auto sink = std::make_unique<AudioSink>();
+    std::string error;
+    if (!sink->Open(error))
+    {
+        if (!m_audioReported.exchange(true))
+        {
+            if (const auto runtime = m_runtime.lock())
+                runtime->Trace("surface_audio_open_failed:" + std::to_string(m_definition.surface) + ":" + error);
+        }
+        return false;
+    }
+    m_audio = std::move(sink);
+    if (!m_audioReported.exchange(true))
+    {
+        if (const auto runtime = m_runtime.lock())
+            runtime->Trace("surface_audio:" + std::to_string(m_definition.surface) + ":" + m_audio->Describe());
+    }
+    return true;
+}
+
+bool SurfaceClient::GetAudioParameters(CefRefPtr<CefBrowser>, CefAudioParameters& aParams)
+{
+    // Probe the device once and remember it. This runs on the UI thread before
+    // a stream exists, which is the only moment the format can still be chosen.
+    if (!m_audioFormatKnown.load())
+    {
+        AudioSink::Format format;
+        std::string error;
+        if (AudioSink::ProbeDeviceFormat(format, error))
+        {
+            m_audioFormat = format;
+            m_audioFormatKnown.store(true);
+        }
+        else
+        {
+            // No device: refuse the stream rather than decoding audio nobody
+            // can hear, and say so once. A machine with no output device is a
+            // legitimate state (a headless server running the host).
+            if (!m_audioFormatFailed.exchange(true))
+            {
+                if (const auto runtime = m_runtime.lock())
+                    runtime->Trace("surface_audio_unavailable:" + std::to_string(m_definition.surface) + ":" + error);
+            }
+            return false;
+        }
+    }
+    aParams.sample_rate = static_cast<int>(m_audioFormat.sampleRate);
+    // CEF only offers mono and stereo layouts here, and the device mix format is
+    // almost always stereo; a mono device gets both channels summed by CEF.
+    aParams.channel_layout = m_audioFormat.channels <= 1 ? CEF_CHANNEL_LAYOUT_MONO : CEF_CHANNEL_LAYOUT_STEREO;
+    return true;
+}
+
+void SurfaceClient::OnAudioStreamStarted(CefRefPtr<CefBrowser>, const CefAudioParameters&, const int aChannels)
+{
+    if (!EnsureAudio()) return;
+    m_audio->SetGain(1.0F);
+    if (const auto runtime = m_runtime.lock())
+    {
+        runtime->Trace("surface_audio_stream_started:" + std::to_string(m_definition.surface) + ":channels=" +
+                       std::to_string(aChannels));
+    }
+}
+
+void SurfaceClient::OnAudioStreamPacket(CefRefPtr<CefBrowser>, const float** aData, const int aFrames, const int64_t)
+{
+    // The hot path: no tracing, no locking beyond the sink's own ring, and no
+    // allocation. A page that plays audio calls this ~43 times a second.
+    if (m_audio == nullptr && !EnsureAudio()) return;
+    m_audio->Push(aData, aFrames, m_audioFormat.channels);
+}
+
+void SurfaceClient::OnAudioStreamStopped(CefRefPtr<CefBrowser>)
+{
+    if (const auto runtime = m_runtime.lock())
+    {
+        const std::string detail = m_audio ? m_audio->Describe() : std::string("no_sink");
+        runtime->Trace("surface_audio_stream_stopped:" + std::to_string(m_definition.surface) + ":" + detail);
+    }
+}
+
+void SurfaceClient::OnAudioStreamError(CefRefPtr<CefBrowser>, const CefString& aMessage)
+{
+    // Closing the browser tears its audio socket down, and CEF reports that as
+    // "Socket closed unexpectedly". It is the expected end of a stream that this
+    // surface asked for, so logging it would put a scary line in every session
+    // that ever played a sound.
+    if (m_closing) return;
+    if (const auto runtime = m_runtime.lock())
+    {
+        runtime->Trace("surface_audio_stream_error:" + std::to_string(m_definition.surface) + ":" +
+                       aMessage.ToString());
+    }
+}
