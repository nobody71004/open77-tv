+// ---------------------------------------------------------------------------
+// The transcode routes
+// ---------------------------------------------------------------------------
+//
+// Two same-origin URLs a media page may name, served from inside this process:
+//
+//     /op77/media/probe?u=...       what the decoder says the link is
+//     /op77/media/stream?u=...&ss=  the link, decoded live into WebM
+//
+// There is no listener, port or token: the requests arrive through CEF's own
+// resource dispatch, gated by `SameOrigin`, which means only the page itself
+// can name them -- the same trust boundary every other page file already sits
+// behind. A strict-policy page never reaches the decoder: the routes answer
+// `transcode_disabled` before the policy check would even matter, because a
+// page that cannot reach YouTube's origins has no use for a re-encoded stream
+// either.
+
+/// The path part of a URL, unescaped, without its query.
+std::string RoutePath(const std::string& aUrl)
+{
+    CefURLParts parts;
+    if (!CefParseURL(aUrl, parts)) return {};
+    const auto rules = static_cast<cef_uri_unescape_rule_t>(
+        UU_SPACES | UU_URL_SPECIAL_CHARS_EXCEPT_PATH_SEPARATORS);
+    std::string path = CefURIDecode(CefString(&parts.path), true, rules).ToString();
+    const std::size_t query = path.find('?');
+    if (query != std::string::npos) path.resize(query);
+    return path;
+}
+
+std::string RouteQueryPart(const std::string& aUrl)
+{
+    CefURLParts parts;
+    if (!CefParseURL(aUrl, parts)) return {};
+    return CefString(&parts.query).ToString();
+}
+
+/// A pipe-backed CEF reader: the WebM ffmpeg writes arrives as CEF reads it.
+///
+/// The owning handles live in the reader, so the lifetime is exactly the
+/// response: when CEF has read the last byte (or abandons the request), the
+/// object is released, the pipe closes, and the job handle's closure kills any
+/// still-running encoder. There is no ordering problem to reason about because
+/// there is nothing left to clean up on another thread.
+class PipeReader final : public CefReadHandler
+{
+public:
+    PipeReader(HANDLE aReadEnd, HANDLE aProcess, HANDLE aJob)
+        : m_readEnd(aReadEnd), m_process(aProcess), m_job(aJob)
+    {
+    }
+
+    ~PipeReader() override
+    {
+        if (m_readEnd != nullptr) CloseHandle(m_readEnd);
+        if (m_process != nullptr) CloseHandle(m_process);
+        if (m_job != nullptr) CloseHandle(m_job);
+    }
+
+    PipeReader(const PipeReader&) = delete;
+    PipeReader& operator=(const PipeReader&) = delete;
+
+    size_t Read(void* aPtr, const size_t aSize, const size_t aCount) override
+    {
+        if (m_readEnd == nullptr || aSize == 0 || aCount == 0) return 0;
+        // CEF asks for `aSize * aCount` bytes; a pipe read is capped at 0x7FFF,
+        // so clamp. A short read is not an error for this handler -- the next
+        // call continues the stream.
+        DWORD want = static_cast<DWORD>(aSize * aCount);
+        if (want > 0x7FFF) want = 0x7FFF;
+        DWORD got = 0;
+        if (!ReadFile(m_readEnd, aPtr, want, &got, nullptr)) return 0;
+        if (got == 0) return 0;
+        m_eof = false;
+        return static_cast<size_t>(got);
+    }
+
+    int Seek(int64_t, int) override { return -1; } // A live pipe does not seek.
+    int64_t Tell() override { return 0; }
+    int Eof() override { return m_eof ? 1 : 0; }
+    bool MayBlock() override { return true; }
+
+private:
+    HANDLE m_readEnd;
+    HANDLE m_process;
+    HANDLE m_job;
+    bool m_eof = true;
+
+    IMPLEMENT_REFCOUNTING(PipeReader);
+};
+
+/// The routes' shared answer shape. `470` is not a real HTTP status; anything
+/// 4xx stops a `<video>` element with a clear error and none of the real ones
+/// fits "the host refused this on purpose", so the body names it instead.
+CefRefPtr<CefResourceHandler> TextAnswer(const std::string& aBody, const char* const aType)
+{
+    auto* bytes = static_cast<uint8_t*>(malloc(aBody.size()));
+    if (bytes == nullptr) return nullptr;
+    memcpy(bytes, aBody.data(), aBody.size());
+    auto stream = CefStreamReader::CreateForData(bytes, aBody.size());
+    // CreateForData takes ownership of the allocation through a CefBinaryValue.
+    CefResponse::HeaderMap headers;
+    headers.emplace("Cache-Control", "no-store");
+    return new CefStreamResourceHandler(200, "OK", aType, std::move(headers), stream);
+}
