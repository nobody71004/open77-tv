+    /// <summary>
+    /// One needle, named on failure.
+    /// </summary>
+    /// <remarks>
+    /// `StringAssert.Contains` on a whole source file prints the whole file when
+    /// it fails -- 55 KB for `tv.js` -- and buries the one line the reader needs.
+    /// These are wire checks between files that cannot be run together, so when
+    /// one breaks, the name of the missing string IS the diagnosis.
+    /// </remarks>
+    private static void HasText(string file, string text, string needle)
+    {
+        Assert.IsTrue(text.Contains(needle, StringComparison.Ordinal),
+            file + " no longer contains `" + needle + "`");
+    }
