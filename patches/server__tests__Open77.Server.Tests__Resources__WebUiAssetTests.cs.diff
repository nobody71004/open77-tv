+    /// <summary>
+    /// The frame that shows somebody else's player carries no `sandbox`
+    /// attribute, and that is a measured requirement rather than a preference.
+    /// </summary>
+    /// <remarks>
+    /// The player these sites ship (`vidsrc.buzz/embed/...`) decides whether it
+    /// is allowed to play by copying `document.domain` and reading
+    /// `localStorage`, and Chromium refuses the first of those inside any
+    /// sandboxed frame -- so the site's own verdict came back `sandboxed` and it
+    /// answered "Sandbox is not allowed / Remove the sandbox attribute from the
+    /// iframe to play the video." in place of the film. Both settings were
+    /// measured through the real host; see
+    /// `docs/research/webui-media-and-audio.md`. The attribute is the kind of
+    /// thing an edit re-adds as obviously prudent, which is why it is pinned:
+    /// what bounds a framed site is the page policy, the request blocklist, the
+    /// popup policy and the origin, not this attribute.
+    /// </remarks>
+    [TestMethod]
+    public void TheFramedSiteIsNotSandboxed()
+    {
+        var root = FindRepositoryRoot();
+        var tvJs = File.ReadAllText(
+            Path.Combine(root, "resources", "system", "open77_media", "web", "tv.js"));
+
+        Assert.IsFalse(tvJs.Contains("setAttribute(\"sandbox\""),
+            "the framed site must carry no sandbox attribute -- the players these sites ship refuse to play inside one");
+
+        // The permissions the frame DOES grant, and the referrer policy, are the
+        // half that must survive: a player needs `encrypted-media` and autoplay,
+        // and the sites that check a referrer would otherwise be sent the
+        // surface's own origin.
+        StringAssert.Contains(tvJs, "frame.setAttribute(\"allow\",");
+        StringAssert.Contains(tvJs, "autoplay; fullscreen; encrypted-media; picture-in-picture");
+        StringAssert.Contains(tvJs, "frame.setAttribute(\"referrerpolicy\", \"no-referrer\")");
+    }
