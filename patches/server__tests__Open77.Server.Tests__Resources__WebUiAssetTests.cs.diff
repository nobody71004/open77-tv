+    /// <summary>
+    /// The curtain and the reveal are one feature written in five files, and this
+    /// is the test that would have caught the state the feature was actually in:
+    /// every layer finished except the two that draw it.
+    /// </summary>
+    /// <remarks>
+    /// The failure mode is worth naming precisely, because no log and no module
+    /// test can see it. `tv.html` carried the pelmet, the two panels, the gold
+    /// braid and the countdown; `server/main.lua` held `open|closed|reveal`,
+    /// validated it, broadcast it and stored it; `client/main.lua` forwarded the
+    /// page's request and played the race resource's own countdown beats on the
+    /// beats it heard. Between them, `tv.js` read none of it and `tv.css` styled
+    /// none of it -- so a screen told to reveal did nothing at all, silently,
+    /// with every half of the feature present and tested on its own side.
+    ///
+    /// Each assertion names one end of one wire, and the last two are generators
+    /// rather than samples: every class the page toggles must have a rule, and
+    /// every element it reads by id must be in the document. Those two are the
+    /// checks that fail on the half-built state above.
+    /// </remarks>
+    [TestMethod]
+    public void TheCurtainIsDrawnFromTheServerStateAndReportsItsBeats()
+    {
+        var root = FindRepositoryRoot();
+        var web = Path.Combine(root, "resources", "system", "open77_media", "web");
+        var tvJs = File.ReadAllText(Path.Combine(web, "tv.js"));
+        var tvCss = File.ReadAllText(Path.Combine(web, "tv.css"));
+        // The stylesheet's own prose paints nothing, and the first version of the
+        // check below was satisfied by the words `.flare` and `.parting` in a
+        // comment -- a generator that asserted almost nothing. Comments out, and
+        // a rule has to look like a rule.
+        var cssRules = Regex.Replace(tvCss, @"/\*.*?\*/", string.Empty, RegexOptions.Singleline);
+        var tvHtml = File.ReadAllText(Path.Combine(web, "tv.html"));
+        var server = File.ReadAllText(Path.Combine(
+            root, "resources", "system", "open77_media", "server", "main.lua"));
+        var client = File.ReadAllText(Path.Combine(
+            root, "resources", "system", "open77_media", "client", "main.lua"));
+
+        // The pieces the timeline moves, including the colours on the start beat.
+        foreach (var id in new[]
+        {
+            "curtain", "curtain-countdown", "curtain-flare", "curtain-toggle", "reveal",
+        })
+        {
+            HasText("tv.html", tvHtml, "id=\"" + id + "\"");
+        }
+        HasText("tv.html", tvHtml, "class=\"curtain-panel curtain-left\"");
+        HasText("tv.html", tvHtml, "class=\"curtain-panel curtain-right\"");
+
+        // The three modes are the server's vocabulary and the page's; the page
+        // reads them out of the state rather than inventing a duration or a
+        // colour of its own.
+        HasText("tv.js", tvJs,
+            "curtain: typeof payload.curtain === \"string\" ? payload.curtain : state.curtain");
+        HasText("tv.js", tvJs, "const CURTAIN_OPEN = \"open\";");
+        HasText("tv.js", tvJs, "const CURTAIN_CLOSED = \"closed\";");
+        HasText("tv.js", tvJs, "const CURTAIN_REVEAL = \"reveal\";");
+        HasText("server/main.lua", server, "curtain = \"open\",");
+        HasText("server/main.lua", server,
+            "if value ~= \"open\" and value ~= \"closed\" and value ~= \"reveal\" then");
+
+        // A state that merely re-states the mode must not restart the timeline:
+        // the server re-broadcasts every television on every control, so another
+        // player nudging the volume would otherwise restart the countdown for
+        // everyone, forever.
+        HasText("tv.js", tvJs,
+            "if (state.curtain !== appliedCurtain) presentCurtain(state.curtain);");
+
+        // The beats. The page owns the clock and says what it is doing; the
+        // client's Lua half plays the race start's own sound and effect on the
+        // beat it hears, because that is the presentation a race already has.
+        HasText("tv.js", tvJs, "report(\"reveal_tick\", tick);");
+        HasText("tv.js", tvJs, "report(\"reveal_start\", \"the panels part\");");
+        HasText("client/main.lua", client, "payload.status == \"reveal_tick\"");
+        HasText("client/main.lua", client, "payload.status == \"reveal_start\"");
+        HasText("client/main.lua", client, "playRevealCue(\"sq024_race_countdown\")");
+        HasText("client/main.lua", client, "playRevealVfx(entry)");
+
+        // The two buttons go to the server, like the URL bar and the volume keys,
+        // so the curtain every client draws is the one the server holds.
+        HasText("tv.js", tvJs, "bridge.emit(\"media:curtain\"");
+        HasText("client/main.lua", client, "page:on(\"media:curtain\"");
+
+        // The clock itself: the numbers come before the panels part, and the
+        // panels travel for as long as the stylesheet says they do -- one figure
+        // written twice, which is exactly the pair that drifts.
+        HasText("tv.js", tvJs, "ticks: [\"3\", \"2\", \"1\"]");
+        HasText("tv.js", tvJs, "part: 2400");
+        HasText("tv.css", tvCss, "transition: transform 2.4s");
+
+        // Every beat the page switches on by name must be something the
+        // stylesheet draws. A class with no rule is a beat that happens in the
+        // state and nowhere on the screen -- silently, which is the whole point.
+        foreach (var name in new[] { "parting", "flare", "tick" })
+        {
+            Assert.IsTrue(
+                Regex.IsMatch(tvJs,
+                    @"classList\.(add|remove|toggle)\(\s*" + Regex.Escape("\"" + name + "\"")),
+                "tv.js no longer toggles the `" + name + "` class the reveal is built on");
+            Assert.IsTrue(
+                Regex.IsMatch(cssRules, @"\." + name + @"\b[^{}]*\{"),
+                "tv.css has no rule for the `" + name + "` class tv.js toggles");
+        }
+
+        // And every element the page reads by id must exist in the document: a
+        // missing node throws at the moment of the reveal.
+        foreach (Match read in Regex.Matches(tvJs, @"getElementById\(""([^""]+)""\)"))
+        {
+            HasText("tv.html", tvHtml, "id=\"" + read.Groups[1].Value + "\"");
+        }
+    }
