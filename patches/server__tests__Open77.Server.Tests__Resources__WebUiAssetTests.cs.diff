+    /// <summary>
+    /// The borderline a cinema record declares reaches the panel, and the panel's
+    /// edge and the glow around it are the same colour.
+    /// </summary>
+    /// <remarks>
+    /// A 30 m rectangle watched in the dark reads as a hole in the world without
+    /// an edge on it, which is why the two cinema records in `shared/records.lua`
+    /// carry `#c8102e` and why nothing else does. The colour is written once -- in
+    /// the record -- and travels to the glass through the snapshot, the page state
+    /// and a CSS custom property. It is the custom property rather than a bare
+    /// `border-color` that makes this one fact instead of two: the glow is what
+    /// the eye reads as a lit edge, and a record edited to another colour would
+    /// otherwise move the border and leave the old halo behind it.
+    /// </remarks>
+    [TestMethod]
+    public void TheCinemaBorderIsDrawnFromTheRecordThatDeclaresIt()
+    {
+        var root = FindRepositoryRoot();
+        var web = Path.Combine(root, "resources", "system", "open77_media", "web");
+        var tvJs = File.ReadAllText(Path.Combine(web, "tv.js"));
+        var tvCss = File.ReadAllText(Path.Combine(web, "tv.css"));
+        // The stylesheet's own prose paints nothing, and the first version of the
+        // check below was satisfied by the words `.flare` and `.parting` in a
+        // comment -- a generator that asserted almost nothing. Comments out, and
+        // a rule has to look like a rule.
+        var cssRules = Regex.Replace(tvCss, @"/\*.*?\*/", string.Empty, RegexOptions.Singleline);
+        var records = File.ReadAllText(Path.Combine(
+            root, "resources", "system", "open77_media", "shared", "records.lua"));
+        var server = File.ReadAllText(Path.Combine(
+            root, "resources", "system", "open77_media", "server", "main.lua"));
+        var client = File.ReadAllText(Path.Combine(
+            root, "resources", "system", "open77_media", "client", "main.lua"));
+
+        // The record is the only place the colour is chosen, and it is the two
+        // cinema panels that choose one.
+        HasText("records.lua", records, "border = \"#c8102e\",");
+        Assert.AreEqual(2, Regex.Matches(records, @"border = ""#").Count,
+            "the bordering is the cinema records' own declaration, not a default for the catalogue");
+
+        // The snapshot, the page state, and the page.
+        HasText("server/main.lua", server, "border = entry.border,");
+        HasText("client/main.lua", client, "border = entry.spec.border,");
+        HasText("tv.js", tvJs,
+            "border: typeof payload.border === \"string\" ? payload.border : state.border,");
+        HasText("tv.js", tvJs, "elements.frame.style.setProperty(\"--frame\", wanted);");
+
+        // The one fact, drawn in two places off one property.
+        HasText("tv.css", tvCss, "border-color: var(--frame, #c8102e);");
+        HasText("tv.css", tvCss, "0 0 2.2vmin var(--frame, #c8102e);");
+        // A panel that owes somebody a colour owes them no click either: the
+        // frame is a picture over the picture, not a thing on top of it.
+        Assert.IsTrue(Regex.IsMatch(cssRules, @"\.frame \{[^}]*pointer-events: none;"),
+            "the frame must not swallow input aimed at the screen behind it");
+    }
