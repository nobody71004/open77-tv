+    /// <summary>
+    /// A television that is paused when it is given a link still shows
+    /// something, because "paused" and "black" are not the same answer.
+    /// </summary>
+    /// <remarks>
+    /// The report was a 100 ft cinema screen showing black while the same link
+    /// played on the 150 ft set beside it. The session log says why: the 100 ft
+    /// set carried `paused=true`, its player reported `unstarted at 0.0s` eleven
+    /// times and never `playing`, and the page builds its player with
+    /// `autoplay: 1` and then immediately pauses a stream that has never started
+    /// -- which leaves a YouTube player painting nothing at all. Its own recovery
+    /// (`watchYouTube`) deliberately refuses to nudge a player the operator asked
+    /// to pause, so nothing on the page could recover.
+    ///
+    /// Two files own the rule, so both are pinned: the set must not autoplay what
+    /// it is about to pause (and should cue, which is what puts the poster on
+    /// screen), and a new link must clear the pause, because pasting a link is a
+    /// play request and the transport state is the server's.
+    /// </remarks>
+    [TestMethod]
+    public void APausedTelevisionShowsAPictureRatherThanNothing()
+    {
+        var root = FindRepositoryRoot();
+        var tvJs = File.ReadAllText(
+            Path.Combine(root, "resources", "system", "open77_media", "web", "tv.js"));
+        var server = File.ReadAllText(
+            Path.Combine(root, "resources", "system", "open77_media", "server", "main.lua"));
+
+        // The player is told not to autoplay a set that is paused, and is cued so
+        // the poster arrives: ``autoplay: 1`` followed by `pauseVideo` is the
+        // black rectangle this test exists for.
+        StringAssert.Contains(tvJs, "autoplay: state.paused ? 0 : 1");
+        StringAssert.Contains(tvJs, "cueVideoById(videoId)");
+
+        // And a link clears the pause on the server, which is the half a re-paste
+        // has to fix: the menu cannot reach a paused set's player from outside.
+        var urlAction = server.IndexOf("elseif action == \"url\" then", StringComparison.Ordinal);
+        Assert.IsTrue(urlAction >= 0, "the media server must still accept a url action");
+        var nextAction = server.IndexOf("elseif action ==", urlAction + 1, StringComparison.Ordinal);
+        Assert.IsTrue(nextAction > urlAction, "the url action must be followed by another action");
+        StringAssert.Contains(
+            server.Substring(urlAction, nextAction - urlAction), "entry.paused = false");
+    }
