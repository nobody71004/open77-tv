+namespace ScreenInput
+{
+/// The page-pixel position, expressed the way the panel draws it.
+///
+/// A free function here rather than in the header because it needs the surface
+/// type: the pointer is stored as a fraction of the page, the input path works
+/// in the page's view pixels, and this is the one place the two meet.
+void FeedPointer(const Surface& aSurface, const POINT aPoint)
+{
+    if (s_screenInputSurface.load(std::memory_order_relaxed) != aSurface.definition.surface) return;
+    const float width = static_cast<float>(std::max(1U, aSurface.viewWidth.load(std::memory_order_acquire)));
+    const float height = static_cast<float>(std::max(1U, aSurface.viewHeight.load(std::memory_order_acquire)));
+    SetPointer((static_cast<float>(aPoint.x) + 0.5F) / width,
+               (static_cast<float>(aPoint.y) + 0.5F) / height);
+}
+
+State Get()
+{
+    State state{};
+    state.surface = s_screenInputSurface.load(std::memory_order_acquire);
+    if (state.surface == 0) return state;
+    // Derived from the focus rather than tracked beside it. Every existing way a
+    // surface can stop owning input -- hidden, closed, generation replaced, the
+    // resource stopped, the session ended -- already ends with `SetFocus(...,
+    // false, false)`, and a second flag that had to be cleared in all of those
+    // places would be wrong in one of them within a week. A surface that holds no
+    // cursor focus is not being pointed at, whatever this module remembers.
+    SurfaceId focused = 0;
+    bool cursor = false;
+    bool keyboard = false;
+    {
+        const std::scoped_lock lock(s_focusMutex);
+        focused = s_focusSurface;
+        cursor = s_focusCursor;
+        keyboard = s_focusKeyboard;
+    }
+    if (focused != state.surface || !cursor || !keyboard)
+    {
+        return State{};
+    }
+    state.active = true;
+    state.u = s_screenInputU.load(std::memory_order_acquire);
+    state.v = s_screenInputV.load(std::memory_order_acquire);
+    state.pointerOnScreen = s_screenInputPointerOnScreen.load(std::memory_order_acquire);
+    state.screenU = s_screenInputScreenU.load(std::memory_order_acquire);
+    state.screenV = s_screenInputScreenV.load(std::memory_order_acquire);
+    return state;
+}
+
+bool Take(const uint64_t aSurface, const float aU, const float aV)
+{
+    if (aSurface == 0) return false;
+    const auto surface = FindSurface(aSurface);
+    if (!surface || !surface->presentationAllowed.load(std::memory_order_acquire))
+    {
+        return false;
+    }
+    s_screenInputSurface.store(aSurface, std::memory_order_release);
+    s_screenInputU.store(std::clamp(aU, 0.0F, 1.0F), std::memory_order_release);
+    s_screenInputV.store(std::clamp(aV, 0.0F, 1.0F), std::memory_order_release);
+    // Nothing has published a drawn position for this session yet, and the last
+    // one belongs to whoever held the screen before. Until the panel says where
+    // its quad is, the cursor is the raw pointer's, not somebody else's place.
+    ClearPointerOnScreen();
+    // Cursor AND keyboard, and never `keepGameInput`: the whole point of taking a
+    // screen over is that the game stops acting on the same keys.
+    if (!SetFocus(aSurface, true, true, false))
+    {
+        s_screenInputSurface.store(0, std::memory_order_release);
+        return false;
+    }
+    // Seed the page pointer from the crosshair, so the first thing the player
+    // clicks is the thing they were looking at.
+    //
+    // `aU`/`aV` is what the PANEL draws its dot from; the pointer the input path
+    // clicks with is `s_pointerX`/`s_pointerY`, a separate accumulator in
+    // viewport pixels. Both have to start at the same place or the first click of
+    // a session lands wherever the last menu session left the OS pointer -- the
+    // dot would be drawn at the crosshair and the click would arrive somewhere
+    // else entirely, which is the one failure a browser over a television cannot
+    // be debugged from the log afterwards. Written here rather than in the panel
+    // because this is the side that knows how big the page is, and because the
+    // seed has to be in place before the first motion sample is accumulated onto
+    // it.
+    const float clampedU = std::clamp(aU, 0.0F, 1.0F);
+    const float clampedV = std::clamp(aV, 0.0F, 1.0F);
+    const uint32_t viewportWidth = std::max(1U, s_viewportWidth.load(std::memory_order_acquire));
+    const uint32_t viewportHeight = std::max(1U, s_viewportHeight.load(std::memory_order_acquire));
+    s_pointerX.store(static_cast<LONG>(clampedU * static_cast<float>(viewportWidth - 1U)),
+                     std::memory_order_release);
+    s_pointerY.store(static_cast<LONG>(clampedV * static_cast<float>(viewportHeight - 1U)),
+                     std::memory_order_release);
+    s_pointerInitialized.store(true, std::memory_order_release);
+    Log(LogLevel::Info, std::format(
+        "screen input: surface {} taken (pointer at {:.3f}, {:.3f}; page {}x{})", aSurface,
+        static_cast<double>(clampedU), static_cast<double>(clampedV), viewportWidth,
+        viewportHeight));
+    return true;
+}
+
+void Release()
+{
+    const uint64_t surface = s_screenInputSurface.exchange(0, std::memory_order_acq_rel);
+    if (surface == 0) return;
+    s_screenInputU.store(0.5F, std::memory_order_release);
+    s_screenInputV.store(0.5F, std::memory_order_release);
+    ClearPointerOnScreen();
+    // Also the release that hands the cursor back: the overlay stops placing it
+    // on a panel the moment this session ends, so ending the session is what
+    // returns it to the raw pointer -- and what makes the screen stop being the
+    // thing the keyboard is typed into.
+    static_cast<void>(SetFocus(surface, false, false));
+    Log(LogLevel::Info, std::format("screen input: surface {} released", surface));
+}
+
+void SetPointer(const float aU, const float aV)
+{
+    // Cheap enough to call at mouse rate: two relaxed stores, no lock, and the
+    // reader is one frame behind by design (`Get` is polled by the panel).
+    if (s_screenInputSurface.load(std::memory_order_relaxed) == 0) return;
+    s_screenInputU.store(std::clamp(aU, 0.0F, 1.0F), std::memory_order_relaxed);
+    s_screenInputV.store(std::clamp(aV, 0.0F, 1.0F), std::memory_order_relaxed);
+}
+
+void PublishPointerOnScreen(const float aU, const float aV)
+{
+    // The session check is a relaxed read of the one field the panel writes and
+    // the render thread reads: a publish that races a release is harmless (the
+    // session is gone, so nothing reads it), and taking the focus mutex on the
+    // game thread to close that race would put a lock in the frame path for
+    // nothing.
+    if (s_screenInputSurface.load(std::memory_order_relaxed) == 0) return;
+    s_screenInputScreenU.store(std::clamp(aU, 0.0F, 1.0F), std::memory_order_release);
+    s_screenInputScreenV.store(std::clamp(aV, 0.0F, 1.0F), std::memory_order_release);
+    s_screenInputPointerOnScreen.store(true, std::memory_order_release);
+}
+
+void ClearPointerOnScreen()
+{
+    s_screenInputPointerOnScreen.store(false, std::memory_order_release);
+}
