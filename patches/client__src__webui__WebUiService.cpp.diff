+bool ApplyBlocklist(std::vector<std::string> aHosts, std::vector<std::string> aTokens,
+                    const uint64_t aRevision, std::string aSource, std::string& aError)
+{
+    if (!s_initialized.load(std::memory_order_acquire))
+    {
+        aError = "webui_service_unavailable";
+        return false;
+    }
+    // Deliberately no `s_connected` check here: `SendPayload` has one, and a
+    // policy pushed during the loading screen -- before the pipe is up -- is a
+    // policy the client can hold and send the moment it is. The one thing this
+    // must not do is report success for a message that was dropped, which is
+    // why the answer is SendPayload's own return value rather than `true`.
+    AdBlockPolicyPayload payload;
+    payload.revision = aRevision;
+    payload.source = std::move(aSource);
+    payload.hosts = std::move(aHosts);
+    payload.tokens = std::move(aTokens);
+    if (!SendPayload(MessageType::AdBlockPolicy, payload))
+    {
+        aError = "blocklist_not_accepted";
+        return false;
+    }
+    Log(LogLevel::Info, std::format(
+        "Open77 web ad blocklist pushed to the host: revision {} -- {} hosts, {} tokens from {}",
+        payload.revision, payload.hosts.size(), payload.tokens.size(),
+        payload.source.empty() ? "this client" : payload.source));
+    return true;
+}
+
+bool BlocklistState(AdBlockStatePayload& aOut, std::string& aError)
+{
+    const std::scoped_lock lock(s_blocklistMutex);
+    if (!s_blocklistStateKnown)
+    {
+        // Two real causes, one answer: no policy has been pushed in this session,
+        // or a policy was pushed to a host too old to answer. Both mean "nobody
+        // has confirmed what is in force", which is what the caller must not
+        // round up to working rules.
+        aError = "no_blocklist_receipt";
+        return false;
+    }
+    aOut = s_blocklistState;
+    return true;
+}
