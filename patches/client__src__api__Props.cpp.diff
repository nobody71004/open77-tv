+/// Puts a prop entity where it was asked to be, by writing its root transform.
+///
+/// WHY THIS IS NOT THE AI CHANNEL ANY MORE -- the reason the moving controls did
+/// nothing. A prop used to be moved with `DynamicEntityService::ApplyTransform`,
+/// which queues an `AI::TeleportCommand` inside an `NPCCommandEvent`: the
+/// puppet's own command channel, and the right instrument for a body, because it
+/// asks the body's AI to move itself and so keeps the locomotion controller in
+/// agreement (see NpcReplication.cpp). **A prop has no AI component.** Nothing
+/// consumes the command, and nothing in the chain notices: the queue call
+/// returns true, `SetTransform` returned `Ok`, the resource's entry moved,
+/// `media.list` reported the new coordinates and the client logged "transform
+/// queued" -- while the cabinet stood exactly where it was. Reported, exactly, as
+/// "the moving controls are not working".
+///
+/// It is the same failure `Movement::Teleport` already records for
+/// `gameTeleportationFacility::Teleport`: a call that reports success and changes
+/// nothing. The write that does move an entity is the one that function and
+/// `Doors::Sink` use, and it is here for the same measured reason.
+///
+/// `entEntity::transformComponent` is the entity root, so it has no parent to
+/// compose with and its local transform IS the entity's world placement. Yaw
+/// only, as in `Movement::Teleport`: a prop stands upright and every quad in the
+/// catalogue is a yaw-rotated rectangle.
+[[nodiscard]] bool PlaceEntity(
+    const Core::EntityId aEntity,
+    const float (&aPosition)[3],
+    const float aYaw)
+{
+    auto object = EntityService::Lock(aEntity);
+    auto* const entity = object != nullptr
+        ? static_cast<RED4ext::ent::Entity*>(object.GetPtr())
+        : nullptr;
+    if (entity == nullptr || entity->status != RED4ext::EntityStatus::Attached)
+    {
+        return false;
+    }
+
+    auto* const root = entity->transformComponent;
+    auto* const setPosition = Engine::Rtti::ClassNative("entIPlacedComponent", "SetLocalPosition");
+    auto* const setOrientation = Engine::Rtti::ClassNative("entIPlacedComponent", "SetLocalOrientation");
+    if (root == nullptr || setPosition == nullptr || setOrientation == nullptr ||
+        setPosition->params.size() != 1 || setOrientation->params.size() != 1)
+    {
+        return false;
+    }
+
+    RED4ext::Vector4 position{aPosition[0], aPosition[1], aPosition[2], 1.0F};
+    RED4ext::StackArgs_t positionArgs;
+    positionArgs.emplace_back(nullptr, &position);
+    const bool moved = RED4ext::ExecuteFunction(root, setPosition, nullptr, positionArgs);
+
+    const auto halfYaw = aYaw * 0.5F * 3.14159265358979323846F / 180.0F;
+    RED4ext::Quaternion orientation{0.0F, 0.0F, std::sin(halfYaw), std::cos(halfYaw)};
+    RED4ext::StackArgs_t orientationArgs;
+    orientationArgs.emplace_back(nullptr, &orientation);
+    static_cast<void>(RED4ext::ExecuteFunction(root, setOrientation, nullptr, orientationArgs));
+
+    return moved;
+}
