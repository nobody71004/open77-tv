+    const double m[3][3] = {{r.x, u.x, -dx}, {r.y, u.y, -dy}, {r.z, u.z, -1.0}};
+    const double rhs[3] = {-c.x, -c.y, -c.z};
+    const double det = (m[0][0] * ((m[1][1] * m[2][2]) - (m[1][2] * m[2][1]))) -
