+        CHECK(Clip::SamplePoints(region, samples));
+        double at[4][2];
+        double depths[4];
+        for (int i = 0; i < 4; ++i)
+        {
+            const Vec3 p = screen.At(samples[i][0], samples[i][1]);
+            const auto n = camera.Normalised(p);
+            at[i][0] = n[0];
+            at[i][1] = n[1];
+            depths[i] = p.z;
+        }
