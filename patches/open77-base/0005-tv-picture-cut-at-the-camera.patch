+            depths[i] = static_cast<double>(z);
+        }
+        Clip::Map map;
+        CHECK(Clip::SolveMap(samples, at, depths, Clip::kDefaultPositionTolerance, map));
+        double worst = 0.0;
+        for (int j = 0; j <= 50; ++j)
