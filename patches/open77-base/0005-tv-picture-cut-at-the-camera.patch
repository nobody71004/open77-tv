+    if (SD::BuildFromMap(aMap, SD::DepthModel{}, size, size, size, SD::Tuning{}, false, probe) != SD::Status::Ok)
+    {
+        return false;
+    }
+    draw.clipped = true;
+    draw.count = region.count;
+    std::memcpy(draw.map, aMap.m, sizeof(draw.map));
+    draw.centreDepth = 1.0F;
