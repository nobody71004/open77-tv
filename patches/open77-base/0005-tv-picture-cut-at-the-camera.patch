+        CHECK(worst < 0.05);
+    }
+
+    // -- refusals ------------------------------------------------------------------
+    {
+        const Screen screen = Cinema();
+        const Clip::Polygon region =
+            Clip::VisibleRegion(screen.Depth(0.0, 0.0), screen.Depth(1.0, 0.0), screen.Depth(0.0, 1.0));
