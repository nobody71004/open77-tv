+        if (!Check(EncodePayload(policy, encoded), "a policy must encode") ||
+            !Check(EncodePayload(policy, message.payload), "a policy must encode into a message")) return 1;
+        AdBlockPolicyPayload decoded;
+        if (!Check(DecodePayload(message, decoded), "a policy must decode") ||
+            !Check(decoded.revision == 7 && decoded.source == policy.source &&
+                       decoded.hosts == rawHosts && decoded.tokens == rawTokens,
+                   "a decoded policy must be the one that was sent") ||
+            !Check(Decode(Encode(message), message, reason), "a policy message must frame and parse") ||
+            !Check(DecodePayload(message, decoded) && decoded.hosts.size() == 2,
+                   "...and survive the framing round trip")) return 1;
+
+        AdBlockStatePayload state;
+        state.revision = 7;
+        state.compiledRules = static_cast<uint32_t>(compiled);
+        state.hostRules = 2;
+        state.tokenRules = 1;
+        state.refused = {"broad:needs_a_domain"};
+        std::vector<uint8_t> stateBytes;
+        if (!Check(EncodePayload(state, stateBytes), "a receipt must encode")) return 1;
+        Message stateMessage;
+        stateMessage.type = MessageType::AdBlockState;
+        stateMessage.payload = stateBytes;
+        AdBlockStatePayload stateBack;
+        if (!Check(DecodePayload(stateMessage, stateBack), "a receipt must decode") ||
+            !Check(stateBack.hostRules == 2 && stateBack.refused.size() == 1 &&
+                       stateBack.refused[0] == "broad:needs_a_domain" &&
+                       stateBack.compiledRules == compiled,
+                   "a receipt must carry the counts the server reports on")) return 1;
+
+        // The bounds, which are the only thing standing between an operator
+        // typo and a client that cannot load a page.
+        AdBlockPolicyPayload oversized = policy;
+        oversized.hosts.assign(513, std::string("newads.test"));
+        if (!Check(!EncodePayload(oversized, encoded), "513 rules must not encode")) return 1;
+        AdBlockPolicyPayload tooLong = policy;
+        tooLong.hosts = {std::string(300, 'a')};
+        if (!Check(!EncodePayload(tooLong, encoded), "a 300-byte rule must not encode")) return 1;
+    }
+
+    {
+        using namespace op77::WebUI::Framing;
+        const std::string ours = "r-tv-3-g-1.cym-ui";
+        const auto verdict = [&](const std::vector<Header>& aHeaders)
+        {
+            return EvaluateFraming(aHeaders, ours);
+        };
+
+        // -- whether a document may be framed at all ------------------------
+        if (!Check(verdict({}).allowed, "a response with no framing headers may be framed") ||
+            !Check(!verdict({{"X-Frame-Options", "SAMEORIGIN"}}).allowed &&
+                       verdict({{"x-frame-options", "SAMEORIGIN"}}).violation == "x-frame-options",
+                   "SAMEORIGIN refuses a television, which is never the same origin") ||
+            !Check(!verdict({{"X-Frame-Options", "deny"}}).allowed,
+                   "DENY must be read case-insensitively") ||
+            !Check(!verdict({{"X-Frame-Options", "ALLOW-FROM https://tv.test"}}).allowed,
+                   "ALLOW-FROM is not honoured by any browser and must not be read as a grant") ||
+            !Check(!verdict({{"Content-Security-Policy", "default-src 'self'; frame-ancestors 'self'"}}).allowed &&
+                       verdict({{"Content-Security-Policy", "frame-ancestors 'self'"}}).violation == "frame-ancestors",
+                   "frame-ancestors that does not name us refuses us") ||
+            !Check(verdict({{"Content-Security-Policy", "frame-ancestors *"}}).allowed,
+                   "frame-ancestors * permits everybody") ||
+            !Check(verdict({{"Content-Security-Policy", "frame-ancestors " + ours}}).allowed,
+                   "a site may name this surface's origin as an ancestor on purpose") ||
+            // A page's own other directives are its own business: this build frames
+            // the document and lets it run under its own policy, as a tab would.
+            !Check(verdict({{"Content-Security-Policy", "default-src 'none'; script-src https://cdn.x"}}).allowed,
+                   "a policy with no frame-ancestors must not be read as a framing refusal") ||
+            // Two headers mean both apply, which folding them into one value loses.
+            !Check(!verdict({{"Content-Security-Policy", "frame-ancestors *"},
+                             {"Content-Security-Policy", "frame-ancestors 'none'"}}).allowed,
+                   "every Content-Security-Policy header applies, not the first") ||
+            !Check(verdict({{"X-Frame-Options", "SAMEORIGIN, SAMEORIGIN"}}).violation == "x-frame-options",
+                   "a repeated field value is still a refusal")) return 1;
+
+        // -- resolving a reference against the document it was written in ----
+        const std::string document = "https://shell.test/app/page.html";
+        if (!Check(ResolveUrl(document, "player.html") == "https://shell.test/app/player.html",
+                   "a relative reference must resolve against the document's directory") ||
+            !Check(ResolveUrl(document, "/embed/a") == "https://shell.test/embed/a",
+                   "a root-relative reference must keep the authority") ||
+            !Check(ResolveUrl(document, "//cdn.test/a.js") == "https://cdn.test/a.js",
+                   "a scheme-relative reference must inherit the document's scheme") ||
+            !Check(ResolveUrl(document, "?only=query") == "https://shell.test/app/page.html?only=query",
+                   "a query-only reference keeps the path") ||
+            !Check(ResolveUrl(document, "../up.html") == "https://shell.test/up.html",
+                   "dot segments must be removed, or a candidate lands on the wrong path") ||
+            !Check(ResolveUrl(document, "https://other.test/x") == "https://other.test/x",
+                   "an absolute reference is already resolved") ||
+            !Check(ResolveUrl(document, "  https://spaced.test/x  ") == "https://spaced.test/x",
+                   "surrounding whitespace is not part of a URL") ||
+            // Nothing here may be framed, so nothing here is a candidate.
+            !Check(ResolveUrl(document, "javascript:alert(1)").empty() &&
+                       ResolveUrl(document, "data:text/html,x").empty() &&
+                       ResolveUrl(document, "#fragment").empty() &&
+                       ResolveUrl(document, "mailto:a@b.test").empty() &&
+                       ResolveUrl("not-a-url", "x").empty(),
+                   "a reference that cannot be framed must resolve to nothing")) return 1;
+
+        // -- finding the application a shell page wraps ----------------------
+        //
+        // The shape of the page that produced this work, reduced to one line per
+        // finding: a <base> that re-bases the shell's own relative URLs, an
+        // advertising frame that must not be offered as a candidate, and a real
+        // application nested as both an <iframe> and an <object>.
+        const std::string shell =
+            "<html><head><base href='https://app.example.test/embed/'>"
+            "<script src='https://focusameneducation.com/abc/invoke.js'></script></head><body>"
+            "<iframe id='a' src='player.html' frameborder='0'></iframe>"
+            "<iframe id='b' src=\"https://moviestv.example/\"></iframe>"
+            "<iframe id='ad' src='https://ads.pubmatic.com/x'></iframe>"
+            "<object data='https://v3.example.test/?logo=1'></object>"
+            "<frameset cols='1'><frame src='ignored.html'></frameset>"
+            "<iframe src='player.html'></iframe>"
+            "</body></html>";
+        const auto embeds = FindEmbeds(shell, "https://shell.test/");
+        if (!Check(embeds.size() == 4, "a shell's nested documents must be found once each, ads excluded") ||
+            !Check(embeds[0].url == "https://app.example.test/embed/player.html" && embeds[0].kind == "iframe",
+                   "the first nested document must be read through the page's own <base>") ||
+            !Check(embeds[1].url == "https://moviestv.example/" && embeds[2].kind == "object",
+                   "a quoted absolute URL and an <object data> must both be candidates") ||
+            !Check(embeds[3].kind == "frame" && embeds[3].url == "https://app.example.test/embed/ignored.html",
+                   "<frame> must be read without matching <frameset>") ||
+            !Check(std::none_of(embeds.begin(), embeds.end(), [](const Embed& e)
+                       { return e.url.find("pubmatic") != std::string::npos; }),
+                   "an advertising host must not be offered as the page to show") ||
+            !Check(FindEmbeds("<html><body>no frames here</body></html>", "https://a.test/").empty(),
+                   "a page that nests nothing has no candidates")) return 1;
+    }
+
+    {
+        // A jar is named for the television that keeps it: a resource name
+        // arrives on the wire, so it is input, and a directory name built from
+        // input is where a `..` becomes a deletion somewhere it should not.
+        if (!Check(CookieJar::SanitizeResource("open77_media") == "open77_media",
+                   "a plain resource name is already path-safe") ||
+            !Check(CookieJar::SanitizeResource("") == "surface",
+                   "a nameless resource still gets a component") ||
+            !Check(CookieJar::SanitizeResource("..") == "surface",
+                   "a name made only of dots must not become a path component") ||
+            !Check(CookieJar::SanitizeResource(".hidden") == "hidden",
+                   "a leading dot must be dropped") ||
+            !Check(CookieJar::SanitizeResource("a/b\\c") == "a_b_c",
+                   "separators must not survive into a jar name") ||
+            !Check(CookieJar::SanitizeResource(std::string(200, 'x')).size() ==
+                       CookieJar::kMaximumResourceCharacters,
+                   "a long resource name must be capped")) return 1;
+
+        const auto traversal = CookieJar::SanitizeResource("../..");
+        if (!Check(traversal.find('/') == std::string::npos &&
+                       traversal.find('\\') == std::string::npos &&
+                       (traversal.empty() || traversal.front() != '.'),
+                   "a traversal name must not survive as a path component")) return 1;
+
+        if (!Check(CookieJar::NameFor("open77_media", 7) != CookieJar::NameFor("open77_media", 8),
+                   "two televisions must not share one jar") ||
+            !Check(CookieJar::NameFor("a", 7) != CookieJar::NameFor("b", 7),
+                   "the same surface id in two resources must not share one jar") ||
+            !Check(CookieJar::NameFor("open77_media", 7) == CookieJar::NameFor("open77_media", 7),
+                   "a television's jar name must be stable across its own pages")) return 1;
+
+        const std::filesystem::path dataRoot = L"C:\\data";
+        const auto jarOne = CookieJar::PathFor(dataRoot, "open77_media", 1);
+        const auto jarTwo = CookieJar::PathFor(dataRoot, "open77_media", 2);
+        const auto escaped = CookieJar::PathFor(dataRoot, "../../etc", 3);
+        if (!Check(jarOne.parent_path() == CookieJar::RootFor(dataRoot),
+                   "a jar must live in the cookies directory") ||
+            !Check(jarOne != jarTwo, "two televisions must be given two directories") ||
+            !Check(escaped.parent_path() == CookieJar::RootFor(dataRoot),
+                   "a traversal resource name must not escape the cookies directory") ||
+            !Check(CookieJar::PathFor({}, "open77_media", 1).empty(),
+                   "no data root means no jar of its own, never the default one")) return 1;
+    }
+
+    {
+        // Sweeping and removal, against the real filesystem: the property that
+        // matters is that one television's end cannot touch another's jar, nor
+        // anything the host keeps beside them.
+        const auto base = std::filesystem::temp_directory_path() / UniqueName(L"op77-jar-");
+        const auto dataRoot = base / L"data";
+        const auto jarOne = CookieJar::PathFor(dataRoot, "open77_media", 1);
+        const auto jarTwo = CookieJar::PathFor(dataRoot, "open77_media", 2);
+        const auto bystander = base / L"unrelated";
+        std::error_code ignored;
+        std::filesystem::create_directories(jarOne / L"Cache", ignored);
+        std::filesystem::create_directories(jarTwo, ignored);
+        std::filesystem::create_directories(bystander, ignored);
+        if (!Check(std::filesystem::exists(jarOne) && std::filesystem::exists(jarTwo),
+                   "a jar for each of two televisions must be creatable")) return 1;
+
+        CookieJar::Remove(jarOne);
+        if (!Check(!std::filesystem::exists(jarOne),
+                   "a closed surface's jar must be removed") ||
+            !Check(std::filesystem::exists(jarTwo),
+                   "another television's jar must survive its neighbour closing")) return 1;
+
+        CookieJar::Sweep(dataRoot);
+        if (!Check(!std::filesystem::exists(CookieJar::RootFor(dataRoot)),
+                   "starting the host must leave no jar from the previous session") ||
+            !Check(std::filesystem::exists(bystander),
+                   "the sweep must not reach outside the cookies directory")) return 1;
+
+        std::filesystem::remove_all(base, ignored);
+    }
+
+    {
+        // What a framed site's player asked for, judged well enough to hand to
+        // the decoder. The two questions this answers are "is this a stream at
+        // all" and "is it better than what is already held", and both have a
+        // cost when they are wrong: a script recorded as a stream spends an
+        // ffmpeg on nothing, and a segment kept over a manifest plays four
+        // seconds of the film instead of the film.
+        using op77::WebUI::Sniff::Kind;
+        const auto kind = [](const char* const aUrl) { return Sniff::Classify(aUrl); };
+
+        if (!Check(kind("https://cdn.example/live/master.m3u8") == Kind::Manifest,
+                   "an HLS index is a manifest") ||
+            !Check(kind("https://cdn.example/x/y.mpd?token=1") == Kind::Manifest,
+                   "a DASH manifest is a manifest, query and all") ||
+            // The one that motivated the shape rule: several of these players
+            // address their index as `/playlist/<hash>`, with no extension to
+            // recognise. It is the request that matters most and the one an
+            // extension list would miss.
+            !Check(kind("https://stream.example/playlist/dd54b5f9a8d56334") == Kind::Manifest,
+                   "an extensionless HLS index is still a manifest") ||
+            !Check(kind("https://cdn.example/movie.mp4") == Kind::Progressive,
+                   "an ordinary media file is progressive") ||
+            !Check(kind("https://cdn.example/live/seg-00012.ts") == Kind::Segment,
+                   "a transport-stream chunk is a segment") ||
+            !Check(kind("https://cdn.example/v/init.mp4") == Kind::Segment,
+                   "an fMP4 initialisation fragment is a segment") ||
+            !Check(kind("https://cdn.example/ads/invoke.js") == Kind::None,
+                   "a script is not a stream") ||
+            !Check(kind("https://cdn.example/track/cmf/generic?ttd_pid=x") == Kind::None,
+                   "a tracker is not a stream") ||
+            !Check(kind("https://open77.invalid/op77/media/stream?u=https%3A%2F%2Fcdn.example%2Ffilm.mp4") ==
+                         Kind::None,
+                   "this host's own route is never recorded as the stream it asks about") ||
+            !Check(kind("https://cdn.example/art/poster.jpg") == Kind::None,
+                   "an image is not a stream")) return 1;
+
+        // The ranking, which is the whole policy: a better kind replaces a worse
+        // one and an equal kind never replaces what is already held, so the
+        // first manifest -- the film -- survives the segments that follow it.
+        if (!Check(Sniff::Supersedes(Kind::Manifest, Kind::None) &&
+                       Sniff::Supersedes(Kind::Progressive, Kind::Segment) &&
+                       Sniff::Supersedes(Kind::Manifest, Kind::Progressive),
+                   "a better candidate must replace a worse one") ||
+            !Check(!Sniff::Supersedes(Kind::Manifest, Kind::Manifest) &&
+                       !Sniff::Supersedes(Kind::Segment, Kind::Manifest),
+                   "the first candidate of a kind must be kept, not overwritten") ||
+            !Check(!Sniff::Supersedes(Kind::None, Kind::None),
+                   "nothing never supersedes anything")) return 1;
+    }
+
     std::cout << "Open77 WebCore tests passed\n";
     return 0;
 }
