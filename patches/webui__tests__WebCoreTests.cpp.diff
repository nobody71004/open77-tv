+                   "a window with no click behind it is advertising, whoever serves it") ||
+            !Check(Ads::DecidePopup("https://some-player.test/watch/1", true) == Ads::PopupAction::Follow,
+                   "a window a click asked for must land on the screen, not nowhere") ||
+            !Check(Ads::DecidePopup("javascript:alert(1)", true) == Ads::PopupAction::Drop,
+                   "a javascript: URL is not a window request") ||
+            !Check(Ads::DecidePopup("about:blank", true) == Ads::PopupAction::Drop &&
+                       Ads::DecidePopup("", true) == Ads::PopupAction::Drop,
+                   "empty and about: URLs must be dropped") ||
+            !Check(Ads::Describe(Ads::PopupAction::Follow) == std::string("follow"),
+                   "the policy's name for the trace changed")) return 1;
+    }
