+    // The policy is what decides whether a page may reach the network at all, so
+    // the two things worth pinning are that it survives the wire and that the
+    // mapping is total: an unknown value must fail closed to the strict policy
+    // rather than inheriting whatever the receiving build happens to prefer.
+    if (!Check(PolicyFromWire(0) == WebPagePolicy::Strict &&
+                   PolicyFromWire(1) == WebPagePolicy::Media &&
+                   PolicyFromWire(200) == WebPagePolicy::Strict,
+               "page policy mapping is not the closed set it claims") ||
+        !Check(std::string(ContentSecurityPolicy(WebPagePolicy::Strict)).find(
+                   "frame-src 'none'") != std::string::npos &&
+                   std::string(ContentSecurityPolicy(WebPagePolicy::Media)).find(
+                       "script-src 'self' 'unsafe-inline' https://www.youtube.com") !=
+                       std::string::npos,
+               "page policy directives do not say what they are for") ||
+        // The frame grant: the one directive here that is a grant rather than a
+        // narrowing, and the one a site-based player cannot be served without.
+        // A pasted site is an origin this build cannot enumerate in advance, so
+        // the media policy frames any `https:` origin while the strict policy --
+        // every menu, HUD and panel -- frames nothing at all. Pinned as one
+        // sentence because each half alone is a lie: a `frame-src https:` that
+        // leaked into every surface, or a strict policy that quietly gained an
+        // origin, would both read as correct above. The strict half is asserted
+        // as "names no https origin anywhere", which is the property that makes
+        // it the policy every other surface can be trusted with.
+        !Check(std::string(ContentSecurityPolicy(WebPagePolicy::Media)).find(
+                   "frame-src https:;") != std::string::npos &&
+                   std::string(ContentSecurityPolicy(WebPagePolicy::Media)).find(
+                       "frame-src 'none'") == std::string::npos &&
+                   std::string(ContentSecurityPolicy(WebPagePolicy::Strict)).find(
+                       "https:") == std::string::npos,
+               "the frame grant is not confined to the one policy that exists to "
+               "show somebody else's page") ||
+        // The half that is not a header. A page can be told what it may load and
+        // still be unable to load any of it, because the host decides what leaves
+        // the process: this pins the two halves to one policy, which is what was
+        // false while a television was served the media header and had every
+        // request it made refused on the other side of the process.
+        !Check(AllowsRemoteContent(WebPagePolicy::Strict) == false &&
+                   AllowsRemoteContent(WebPagePolicy::Media) == true,
+               "a policy that permits nothing must not reach the network, and the "
+               "one that exists to play a link must") ||
+        !Check(AllowsRemoteContent(WebPagePolicy::Media) ==
+                   (std::string(ContentSecurityPolicy(WebPagePolicy::Media)) !=
+                    std::string(kStrictContentSecurityPolicy)) &&
+                   AllowsRemoteContent(WebPagePolicy::Strict) ==
+                   (std::string(ContentSecurityPolicy(WebPagePolicy::Strict)) !=
+                    std::string(kStrictContentSecurityPolicy)),
+               "the header and the request gate disagree about one policy"))
+    {
+        return 1;
+    }
