+    // -----------------------------------------------------------------------
+    // The television's two quality decisions: what a framed page may open, and
+    // whether it can be framed at all.
+    //
+    // Both are pure functions over strings, and both are the kind of thing that
+    // fails silently in a game: an over-broad blocklist drops a real player's
+    // window and looks exactly like a broken site, and a framing verdict that is
+    // wrong in either direction shows a blank screen with no line to explain it.
+    // Neither needs a browser, a network or a game to pin, which is why they are
+    // tested here rather than in the host integration suite.
+    // -----------------------------------------------------------------------
+    {
+        using namespace op77::WebUI;
+
+        // -- the host a rule is matched against ----------------------------
+        if (!Check(Ads::LowerHost("https://User@Example.COM:8443/a/b") == "example.com",
+                   "host must be lowercased, and go without userinfo or port") ||
+            !Check(Ads::LowerHost("https://[::1]:8080/x") == "[::1]",
+                   "a bracketed IPv6 literal's colon is not a port separator") ||
+            !Check(Ads::LowerHost("not a url").empty(), "a URL without a scheme has no host") ||
+            !Check(Ads::SchemeOf("HTTPS://x") == "https" && Ads::SchemeOf("javascript:x") == "javascript" &&
+                       Ads::SchemeOf("//x").empty(),
+                   "scheme extraction changed")) return 1;
+
+        // -- the blocklist itself ------------------------------------------
+        if (!Check(Ads::RuleCount() >= 40, "the blocklist must not be silently emptied") ||
+            !Check(Ads::IsBlocked("https://focusameneducation.com/ddc0242a/invoke.js"),
+                   "the host measured on the reporting site must be blocked") ||
+            !Check(Ads::IsBlocked("https://cdn.focusameneducation.com/x.js"),
+                   "a rule must cover its own subdomains") ||
+            !Check(Ads::IsBlocked("https://popads-delivery-7.test/invoke.js"),
+                   "a host that calls itself an advertising host is blocked whatever its domain") ||
+            // ...and the two ways a suffix match goes wrong.
+            !Check(!Ads::IsBlocked("https://notfocusameneducation.com/x.js"),
+                   "a host must not match a rule it merely ends with") ||
+            !Check(!Ads::IsBlocked("https://focusameneducation.com.evil.test/x.js"),
+                   "a rule must not cover a host that puts it in front of its own domain") ||
+            // The one false positive that would break the feature this exists for:
+            // YouTube's media origin shares a registrable domain with an ad network.
+            !Check(!Ads::IsBlocked("https://rr3---sn-abc.googlevideo.com/videoplayback?x=1"),
+                   "YouTube's media origin must not be blocked: googlevideo is not googlesyndication") ||
+            !Check(!Ads::IsBlocked("https://i.ytimg.com/vi/x/hq.jpg"), "thumbnails must not be blocked")) return 1;
+
+        // -- what a framed page may open -----------------------------------
+        if (!Check(Ads::DecidePopup("https://focusameneducation.com/x", true) == Ads::PopupAction::Drop,
+                   "a click on an advertisement is still an advertisement") ||
