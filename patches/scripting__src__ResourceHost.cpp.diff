+    /// Reads a `{ "rule", ... }` array out of a table field, with the bound the
+    /// host's own message encoding uses. A rule that is not a string is a
+    /// refusal rather than a skip: an operator's list is small enough that a
+    /// silently dropped entry is a rule they believe is in force.
+    static bool ReadRuleArray(lua_State* const aState, const int aTable, const char* const aField,
+                              std::vector<std::string>& aOut, std::string& aError)
+    {
+        aOut.clear();
+        lua_getfield(aState, aTable, aField);
+        if (lua_isnil(aState, -1)) { lua_pop(aState, 1); return true; }
+        if (!lua_istable(aState, -1))
+        {
+            lua_pop(aState, 1);
+            aError = std::string("invalid_") + aField;
+            return false;
+        }
+        const auto count = lua_rawlen(aState, -1);
+        if (count > 512)
+        {
+            lua_pop(aState, 1);
+            aError = std::string(aField) + "_out_of_range";
+            return false;
+        }
+        aOut.reserve(count);
+        for (size_t index = 1; index <= count; ++index)
+        {
+            lua_rawgeti(aState, -1, static_cast<lua_Integer>(index));
+            const bool isString = lua_type(aState, -1) == LUA_TSTRING;
+            const std::string rule = isString ? std::string(lua_tostring(aState, -1)) : std::string();
+            lua_pop(aState, 1);
+            if (!isString)
+            {
+                lua_pop(aState, 1);
+                aError = std::string(aField) + "_must_be_strings";
+                return false;
+            }
+            aOut.push_back(rule);
+        }
+        lua_pop(aState, 1);
+        return true;
+    }
