+    /// Reads the quad fields present in the table, leaving anything absent at
+    /// whatever the caller already had. `disabled` out-parameters were avoided
+    /// here: a quad has eight numbers and a bool per axis is eight more things to
+    /// keep in step, so merging happens by not touching what is not named.
+    static bool ReadMediaQuad(
+        lua_State* const aState, const int aIndex, GameBackend::MediaScreenQuad& aOut,
+        std::string& aError)
+    {
+        const auto readVector = [&](const char* const aName, float (&aTarget)[3]) {
+            lua_getfield(aState, aIndex, aName);
+            if (lua_isnil(aState, -1))
+            {
+                lua_pop(aState, 1);
+                return true;
+            }
+            const bool ok = ReadVector3(aState, -1, aTarget);
+            lua_pop(aState, 1);
+            return ok;
+        };
+        if (!readVector("offset", aOut.offset)) { aError = "invalid_offset"; return false; }
+        if (!readVector("right", aOut.right)) { aError = "invalid_right"; return false; }
+        if (!readVector("up", aOut.up)) { aError = "invalid_up"; return false; }
+        // Which side of the panel carries the picture, when the record says.
+        // Absent leaves it at zero, which the native side reads as "not
+        // declared" and draws from both sides -- the behaviour every screen had
+        // before this field existed, so not declaring one cannot blank a screen.
+        if (!readVector("faces", aOut.faces)) { aError = "invalid_faces"; return false; }
+
+        const auto readNumber = [&](const char* const aName, float& aTarget) {
+            lua_getfield(aState, aIndex, aName);
+            const bool absent = lua_isnil(aState, -1);
+            const bool number = !absent && lua_isnumber(aState, -1);
+            if (number) aTarget = static_cast<float>(lua_tonumber(aState, -1));
+            lua_pop(aState, 1);
+            return absent || number;
+        };
+        if (!readNumber("width", aOut.width)) { aError = "invalid_width"; return false; }
+        if (!readNumber("height", aOut.height)) { aError = "invalid_height"; return false; }
+        return true;
+    }
+
+    /// Reads a full definition, merging over `aOut` so an omitted field keeps
+    /// its previous value. `bind` starts from the struct defaults; `update`
+    /// starts from what the screen already has, which is what makes
+    /// `media.update(id, { label = "…" })` mean what it looks like it means.
+    static bool ReadMediaDefinition(
+        lua_State* const aState, const int aIndex, GameBackend::MediaScreenDefinition& aOut,
+        std::string& aError)
+    {
+        if (!lua_istable(aState, aIndex))
+        {
+            aError = "options_must_be_a_table";
+            return false;
+        }
+
+        lua_getfield(aState, aIndex, "prop");
+        if (!lua_isnil(aState, -1))
+        {
+            uint64_t prop = 0;
+            if (!ReadEntityId(aState, -1, prop) || prop == 0)
+            {
+                lua_pop(aState, 1);
+                aError = "invalid_prop_id";
+                return false;
+            }
+            aOut.prop = prop;
+        }
+        lua_pop(aState, 1);
+
+        // A named page must be one this resource owns; an omitted page leaves
+        // the screen's current content alone, and an explicit nil is how a
+        // caller switches a television off without removing it.
+        lua_getfield(aState, aIndex, "page");
+        if (lua_isnil(aState, -1))
+        {
+            lua_getfield(aState, aIndex, "surface");
+            if (!lua_isnil(aState, -1))
+            {
+                uint64_t surface = 0;
+                if (!ReadEntityId(aState, -1, surface))
+                {
+                    lua_pop(aState, 2);
+                    aError = "invalid_surface";
+                    return false;
+                }
+                aOut.surface = surface;
+            }
+            lua_pop(aState, 1);
+        }
+        else if (!ReadOwnedWebPage(aState, -1, aOut.surface, aError))
+        {
+            lua_pop(aState, 1);
+            return false;
+        }
+        lua_pop(aState, 1);
+
+        lua_getfield(aState, aIndex, "label");
+        if (lua_isstring(aState, -1))
+        {
+            size_t length = 0;
+            const char* const text = lua_tolstring(aState, -1, &length);
+            if (length > 128)
+            {
+                lua_pop(aState, 1);
+                aError = "label_too_long";
+                return false;
+            }
+            aOut.label.assign(text, length);
