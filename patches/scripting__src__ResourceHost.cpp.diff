+    static int LuaMediaUpdate(lua_State* const aState)
+    {
+        auto* const context = GetContext(aState);
+        if (!CanUseProps(aState))
+            return PushCameraResult(aState, false, "permission_denied:world.props");
+        if (!context->host->config.game.updateMediaScreen)
+            return PushCameraResult(aState, false, "media_backend_unavailable");
+        uint64_t id = 0;
+        if (!ReadEntityId(aState, 1, id) || id == 0)
+            return PushCameraResult(aState, false, "invalid_screen_id");
+
+        GameBackend::MediaScreenDefinition definition;
+        bool found = false;
+        if (context->host->config.game.mediaScreenSnapshot)
+        {
+            for (const auto& screen : context->host->config.game.mediaScreenSnapshot(
+                     context->instance->definition.name))
+            {
+                if (screen.id != id) continue;
+                definition = screen.definition;
+                found = true;
+                break;
+            }
+        }
+        if (!found) return PushCameraResult(aState, false, "not_found");
+
+        std::string error;
+        if (!ReadMediaDefinition(aState, 2, definition, error))
+            return PushCameraResult(aState, false, error);
+        const bool ok = context->host->config.game.updateMediaScreen(
+            context->instance->definition.name, id, std::move(definition), error);
+        return PushCameraResult(aState, ok, error);
+    }
