+        lua_getfield(aState, aIndex, "quad");
+        if (!lua_isnil(aState, -1))
+        {
+            const bool ok = ReadMediaQuad(aState, -1, aOut.quad, aError);
+            lua_pop(aState, 1);
+            if (!ok) return false;
