 void SelfTestApp::OnBeforeCommandLineProcessing(const CefString&, CefRefPtr<CefCommandLine> aCommandLine)
 {
     // Same GPU switches as the production host, minus the adapter pin: the
     // test proves the path on whatever adapter Chromium picks by itself.
     aCommandLine->AppendSwitch("disable-extensions");
     aCommandLine->AppendSwitch("disable-component-update");
     aCommandLine->AppendSwitch("disable-background-networking");
     aCommandLine->AppendSwitch("disable-direct-composition");
+    if (m_probe)
+    {
+        // A media probe that cannot autoplay measures the browser's gesture
+        // policy, not its codecs. Sound is the point here: muted autoplay would
+        // report a healthy decode and no audio at all.
+        aCommandLine->AppendSwitchWithValue("autoplay-policy", "no-user-gesture-required");
+    }
     if (m_gpu)
     {
         aCommandLine->AppendSwitchWithValue("use-angle", "d3d11");
         aCommandLine->AppendSwitch("ignore-gpu-blocklist");
     }
 }
 
