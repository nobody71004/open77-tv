+
+double LiveSiteEvidence::NumberField(const std::string& aJson, const std::string& aName)
+{
+    // Found by name and then by the colon, rather than by a `"name":` needle.
+    // These samples arrive as the *detail* of a page event, so every quote in
+    // them is escaped once more on the way out (`\"readyState\":4`), and a
+    // needle with the quotes in it matches nothing -- which is exactly how the
+    // first version of this reader reported every sample as -1 and the stage as
+    // "no samples" while twelve of them sat in the vector.
+    const auto at = aJson.find(aName);
+    if (at == std::string::npos) return -1.0;
+    const auto colon = aJson.find(':', at);
+    if (colon == std::string::npos) return -1.0;
+    try
+    {
+        return std::stod(aJson.substr(colon + 1));
+    }
+    catch (...)
+    {
+        return -1.0;
+    }
+}
+
+bool LiveSiteEvidence::Record(const Message& aMessage)
+{
+    WebEventPayload event;
+    if (!DecodePayload(aMessage, event) || event.surface != kLiveSiteSurface) return false;
+    if (event.name == "media:report")
+    {
+        reports.push_back(event.json);
+        std::cerr << "stage=live_report " << event.json << '\n';
+        // Every sample the page was asked for is kept, whatever it says: a
+        // television with nothing playing is a measurement too.
+        if (event.json.find("readyState") != std::string::npos) playback.push_back(event.json);
+    }
+    return true;
+}
