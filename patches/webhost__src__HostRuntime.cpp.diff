+void HostRuntime::SetAdBlockPolicy(const AdBlockPolicyPayload& aPayload)
+{
+    // Built off to the side and published in one assignment: the readers see the
+    // previous list until this one exists, and the next one after, never a
+    // partly-filled object.
+    auto next = std::make_shared<Ads::Blocklist>();
+    std::vector<Ads::Blocklist::Refusal> refusals;
+    next->AddHostRules(aPayload.hosts, refusals);
+    next->AddTokenRules(aPayload.tokens, refusals);
+
+    AdBlockStatePayload receipt;
+    receipt.revision = aPayload.revision;
+    receipt.compiledRules = static_cast<uint32_t>(Ads::RuleCount());
+    receipt.hostRules = static_cast<uint32_t>(next->OperatorHosts().size());
+    receipt.tokenRules = static_cast<uint32_t>(next->OperatorTokens().size());
+    receipt.refused.reserve(refusals.size());
+    for (const auto& refusal : refusals)
+        receipt.refused.push_back(refusal.rule + ":" + refusal.reason);
+
+    {
+        const std::scoped_lock lock(m_blocklistMutex);
+        m_blocklist = std::move(next);
+    }
+
+    // The line an operator reads when they ask whether their network is blocked:
+    // the count, the revision it came from, and why any entry did nothing.
+    std::string trace = "adblock_policy:" + std::to_string(aPayload.revision) + ":" +
+        std::to_string(receipt.hostRules) + " hosts + " + std::to_string(receipt.tokenRules) +
+        " tokens + " + std::to_string(receipt.compiledRules) + " compiled";
+    if (!aPayload.source.empty()) trace += " source=" + aPayload.source;
+    for (const auto& refused : receipt.refused) trace += " refused=" + refused;
+    Trace(trace);
+
+    NotifyAdBlockState(receipt);
+}
+
+void HostRuntime::NotifyAdBlockState(const AdBlockStatePayload& aPayload)
 {
+    std::vector<uint8_t> payload;
+    if (EncodePayload(aPayload, payload))
+        static_cast<void>(Send(MessageType::AdBlockState, std::move(payload)));
 }
 
