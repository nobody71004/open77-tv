+/// A WebUI surface on a world quad.
+///
+/// Nothing is drawn here except the surface: no backdrop, no padding, no border.
+/// A television shows its picture to its edges, and every pixel the overlay
+/// added would be a pixel the page cannot use. The corners arrive already
+/// projected, so this is a pure coordinate change -- normalised to pixels -- and
+/// a hand-off of the surface id to the one module that owns descriptors.
+///
+/// Deliberately silent when the hand-off fails. `DrawSurfaceQuad` returns false
+/// for a surface that is hidden, not ready, or never painted, and that is a
+/// normal transient while a page loads; the screen is simply not drawn this
+/// frame and appears when the page has something to show. A page that never
+/// paints is diagnosed through `webui.status`, which reports exactly which of
+/// those predicates failed -- not by inventing an error here.
+/// Draws one screen's surface into its quad.
+///
+/// `aCorners` arrives already placed for the frame being presented rather than
+/// read from the item, because the item carries the corners the last game tick
+/// produced and the drawer advances them across the interval the present sits in
+/// -- see `s_screenMotion` and `ScreenMotion.hpp`.
+void DrawScreen(ImDrawList* const aDraw, const Item& aItem,
+                const std::array<float, 8>& aCorners, const float aWidth, const float aHeight,
+                const float aAlpha)
+{
+    static_cast<void>(aDraw);
+    if (aItem.surface == 0)
+    {
+        return;
+    }
+    float corners[8]{};
+    for (size_t index = 0; index < 8; index += 2)
+    {
+        corners[index] = aCorners[index] * aWidth;
+        corners[index + 1] = aCorners[index + 1] * aHeight;
+    }
+    const auto alpha = static_cast<uint8_t>(
+        std::clamp(aAlpha * 255.0F, 0.0F, 255.0F));
+    static_cast<void>(WebUiService::DrawSurfaceQuad(aItem.surface, corners, alpha));
+}
